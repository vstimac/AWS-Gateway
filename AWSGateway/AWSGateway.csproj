<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<Nullable>disable</Nullable>
		<UseWindowsForms>true</UseWindowsForms>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="AWSSDK.CloudWatch" Version="4.0.1" />
		<PackageReference Include="AWSSDK.CostExplorer" Version="4.0.1.1" />
		<PackageReference Include="AWSSDK.EC2" Version="4.0.117" />
		<PackageReference Include="AWSSDK.S3" Version="4.0.102.5" />
		<PackageReference Include="AWSSDK.SecurityToken" Version="4.0.100.12" />
		<PackageReference Include="Dapper" Version="2.1.79" />
		<PackageReference Include="itext7" Version="9.7.0" />
		<PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
	</ItemGroup>

	<ItemGroup>
		<None Include="Lang\*.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<ItemGroup>

		<ProjectReference Include="..\AWSGateway.TCPServer\AWSGateway.TCPServer.csproj" />
		<ProjectReference Include="..\AWSGateway.Utils\AWSGateway.Utils.csproj" />	
		<ProjectReference Include="..\AWSGateway.Dialogs\AWSGateway.Dialogs.csproj">
			<ReferenceOutputAssembly>false</ReferenceOutputAssembly>
		</ProjectReference>
	</ItemGroup>

	<Target Name="StopTcpServer" BeforeTargets="PreBuildEvent">
		<Exec Command="taskkill /IM AWSGateway.TCPServer.exe /F"
		      IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true"
		      StandardOutputImportance="low" />
	</Target>

	<!-- ReferenceOutputAssembly=false gore (namjerno, izbjegava kružnu referencu jer se AWSGateway.Dialogs učitava
	     refleksijom) isključuje i uobičajeno automatsko kopiranje izlaza te reference u ovaj izlazni direktorij.
	     Bez ovoga AWSGateway.Dialogs.dll ovdje ostaje zastarjela - build ove datoteke prođe, ali O programu/Pomoć
	     u pokrenutoj aplikaciji i dalje prikazuju staru verziju iz Assembly.LoadFrom. -->
	<Target Name="CopyDialogsAssembly" AfterTargets="Build">
		<ItemGroup>
			<DialogsAssembly Include="$(MSBuildThisFileDirectory)..\AWSGateway.Dialogs\bin\$(Configuration)\$(TargetFramework)\AWSGateway.Dialogs.dll" />
		</ItemGroup>
		<Copy SourceFiles="@(DialogsAssembly)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="Exists('%(DialogsAssembly.Identity)')" />
	</Target>

</Project>